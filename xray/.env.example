# Порт Xray на хосте и в контейнере (для rootless Podman должен быть > 1024).
# По умолчанию 2053, потому что 443/8443 уже заняты nginx-proxy.
XRAY_PORT=2053

# Уровень логирования Xray: debug, info, warning, error
XRAY_LOG_LEVEL=warning

# Маскировочный сайт (dest) и SNI. Должны совпадать.
# Выбирайте крупный сайт с TLS 1.3, доступный с вашего сервера.
XRAY_DEST=www.cloudflare.com:443
XRAY_SERVER_NAME=www.cloudflare.com

# Внешний адрес сервера для ссылки подключения: белый IP или домен (без https:// и без порта)
XRAY_PUBLIC_HOST=vpn.example.com

# Генерируются автоматически командой ./setup.sh — не редактируйте вручную
XRAY_UUID=
XRAY_PRIVATE_KEY=
XRAY_PUBLIC_KEY=
XRAY_SHORT_ID=
